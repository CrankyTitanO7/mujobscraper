# Copy to .env.local. The file is gitignored; never commit real keys.
#
# LLM provider: auto | openai | ollama | none
# "auto" picks an OpenAI-compatible endpoint when a key/base URL is present,
# or Ollama when OLLAMA_HOST is set. It never downloads a model.
JOBSCRAPER_LLM_PROVIDER=auto
JOBSCRAPER_LLM_BASE_URL=https://api.openai.com/v1
JOBSCRAPER_LLM_MODEL=gpt-4o-mini
JOBSCRAPER_LLM_API_KEY=

# OPENAI_API_KEY is also accepted as a fallback API key.

# Local Ollama (no key required):
# JOBSCRAPER_LLM_PROVIDER=ollama
# JOBSCRAPER_LLM_BASE_URL=http://localhost:11434
# JOBSCRAPER_LLM_MODEL=llama3.1
# OLLAMA_HOST=http://localhost:11434

# Optional: point the CLI at a project root other than the current directory.
# JOBSCRAPER_ROOT=/absolute/path/to/jobscraper
